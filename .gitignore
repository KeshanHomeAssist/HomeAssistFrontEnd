node_modules/
dist/
dist-ssr/
.vite/

# Generated from design-export/ by `npm run prepare:ds`.
# Committing these would mean two sources of truth for the same code.
src/ds/index.js
src/site/*.jsx
public/icons/

# Deploy credentials — xneelo FTP details give full write access to the
# hosting account. These must never reach GitHub.
deploy/.env.deploy
.env
.env.local
*.pem
*.key

# Artwork from the design export that the site does not currently use.
# It stays on disk (scripts/split-assets.mjs puts it there) but committing
# ~17MB of unused binaries would bloat every clone forever. The originals live
# in the Claude Design export, which is the source of truth for artwork.
design-export/asset-library/

# Build tarballs. Cloud sessions cannot build inside the iCloud-synced folder
# (vite cannot clear dist/), so the source is packed to ha-src.tgz, staged, and
# built in the container instead. The archive is a transient artefact and one
# was committed by accident on 30 August 2026 at 5.8MB.
*.tgz

# Vite writes a temporary compiled config beside vite.config.js while it builds
# and normally removes it. A build interrupted part-way leaves one behind, and
# one was committed on 30 August 2026 before this rule existed.
vite.config.js.timestamp-*.mjs

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
npm-debug.log*
