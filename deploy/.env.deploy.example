# Copy this file to deploy/.env.deploy and fill it in.
# deploy/.env.deploy is gitignored — it must never be committed.
#
# Find these in konsoleH: your hosting service -> Configuration -> FTP Users.
# The username is shown there; the password is one you set yourself (xneelo does
# not store it, so keep your own record).
#
# Transfers go over SFTP on port 22 — not plain FTP, not FTPS.
# The hostname is your domain, or the server IP if a Web Application Firewall
# sits in front of it.

FTP_HOST="homeassist.co.za"
FTP_PORT="22"
FTP_USER="CHANGE_ME"
FTP_PASS="CHANGE_ME"

# Where each target's files live on the server.
#
# On xneelo the live site is served from the account's public_html. A subdomain
# added in Konsole normally gets its own directory alongside it — confirm the
# exact path in Konsole before the first deploy, because a wrong path here will
# happily upload the new site over the WordPress install.
STAGING_REMOTE_DIR="/public_html/new"
PROD_REMOTE_DIR="/public_html"
